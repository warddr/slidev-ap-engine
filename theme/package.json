{
  "name": "slidev-theme-ap",
  "version": "0.2.0",
  "type": "module",
  "description": "AP Hogeschool Antwerpen theme for Slidev, same look as the reveal.js course decks.",
  "keywords": [
    "slidev-theme",
    "slidev",
    "ap"
  ],
  "slidev": {
    "defaults": {
      "aspectRatio": "16/9",
      "canvasWidth": 1556,
      "fonts": {
        "sans": "Century Gothic, Helvetica",
        "mono": "monospace",
        "provider": "none"
      },
      "colorSchema": "light",
      "highlighter": "shiki",
      "lineNumbers": false,
      "transition": "slide-left"
    }
  },
  "dependencies": {
    "@slidev/types": "53.0.0"
  }
}
